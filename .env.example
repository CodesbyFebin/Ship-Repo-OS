# ── ShipOS environment ───────────────────────────────────────────────────────
# Copy to .env and adjust. SQLite needs nothing beyond the DATABASE_URL.

# Prisma / SQLite database file (created by `bun run db:push`).
DATABASE_URL="file:./db/custom.db"

# LLM enhancement (optional at runtime — every engine has a deterministic
# fallback when the LLM is unreachable or the key is unset).
# OPENAI_API_KEY=""

# Admin token for /api/apikeys (GET/POST/DELETE). Compare is constant-time.
# If unset, those routes fail closed with HTTP 503. Send it as
# `x-shipos-admin-token` or `Authorization: Bearer <token>`.
# SHIPOS_ADMIN_TOKEN=""
